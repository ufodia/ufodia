# BEGIN Selimoglu HTTPS — retain unrelated server rules below
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^(www\.)?selimoglu\.org$ [NC]
  RewriteCond %{HTTPS} !=on
  RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/
  RewriteRule ^ https://selimoglu.org%{REQUEST_URI} [R=301,L,NE]
</IfModule>
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=86400"
</IfModule>
# END Selimoglu HTTPS

# php -- BEGIN cPanel-generated handler, do not edit
# “ea-php72” paketini varsayılan “PHP” programlama dili olarak ayarlayın.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php72 .php .php7 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
